# ---- ContentMind -----------------------------------------------------------
ENVIRONMENT=development

# Comma-separated list of allowed origins for the React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database --------------------------------------------------------------
# SQLite for development. Swap to PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/contentmind
# DATABASE_URL=sqlite:///./contentmind.db  # development
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/contentmind  # production
SQL_ECHO=false

# ---- Hindsight by Vectorize (long-term memory layer) -----------------------
# Run Hindsight with:
#   docker run --rm -it -p 8888:8888 -p 9999:9999 \
#     -e HINDSIGHT_API_LLM_API_KEY=$OPENAI_API_KEY \
#     -e HINDSIGHT_API_LLM_MODEL=gpt-4o-mini \
#     ghcr.io/vectorize-io/hindsight:latest
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=contentmind
HINDSIGHT_TIMEOUT=30
# How many memory statements go into a single retain call
HINDSIGHT_RETAIN_BATCH_SIZE=10
# When Hindsight is unreachable, keep serving from an in-process memory store
# instead of failing. The UI labels this state explicitly.
HINDSIGHT_ALLOW_LOCAL_FALLBACK=true

# ---- LLM -------------------------------------------------------------------
# Supported providers:
#   gemini    -> Google Gemini via the official google-genai SDK (GEMINI_API_KEY)
#   openai    -> any OpenAI-compatible endpoint (LLM_API_KEY + LLM_BASE_URL)
#   heuristic -> force the deterministic strategy engine (offline demos/tests)
# Missing keys never break startup; generation simply falls back to the
# deterministic engine.
LLM_PROVIDER=gemini

# Google AI Studio key. Leave empty to use the deterministic fallback.
# Never commit a real key. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current stable Flash model (structured outputs supported). Override this if
# your project has access to a different model.
LLM_MODEL=gemini-3.8-flash

# Optional vision-model override. Empty means "use LLM_MODEL".
# Media analysis fails honestly (and stays retryable) if this model cannot
# accept image input.
VISION_MODEL=

# OpenAI-compatible providers only (ignored by the Gemini provider):
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Shared request controls
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=2048

# ---- Media pipeline --------------------------------------------------------
# Install ffmpeg/ffprobe and put them on PATH, or set absolute paths here.
# Without them, uploads are stored but analysis is marked partial/failed.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_UPLOADS_DIR=uploads
MEDIA_MAX_VIDEO_MB=500
MEDIA_MAX_IMAGE_MB=25
MEDIA_FFMPEG_TIMEOUT=300
MEDIA_KEYFRAME_COUNT=4

# auto: API whisper when LLM_API_KEY is set, else local faster-whisper,
# else mark transcription unavailable. api/local/none force a path.
WHISPER_PROVIDER=auto
WHISPER_API_MODEL=whisper-1
WHISPER_LOCAL_MODEL=base

# ---- Strategy defaults -----------------------------------------------------
DEFAULT_PLAN_DAYS=7
MAX_PLAN_ITEMS=21
DEFAULT_BRAND_NAME=Northwind AI

# ---- Instagram (Meta) integration (Phase 6) ---------------------------------
# Fill these in locally; never commit real credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/instagram/callback
INSTAGRAM_API_VERSION=v22.0
INSTAGRAM_FRONTEND_BASE_URL=http://localhost:5173
INSTAGRAM_ENCRYPTION_KEY=
INSTAGRAM_SYNC_COOLDOWN_SECONDS=300
INSTAGRAM_MAX_POSTS_PER_SYNC=50

# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
